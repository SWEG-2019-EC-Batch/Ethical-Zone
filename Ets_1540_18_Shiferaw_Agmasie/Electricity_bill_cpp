C++ code


#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    // Step 4.1 and 4.2: Declaration of variables and constants
    const int unit_limit = 50;
    const double first_cost = 1.50;
    const double extra_cost = 2.00;
    const double service_charge = 10.00;

    int number_of_units;
    double energy_charge, total_bill;

    // Step 4.3: Read the input
    cout << "Enter number_of_units:";
    cin >> number_of_units;

    // Step 4.4: Calculate the energy charge
    energy_charge = (number_of_units <= unit_limit)
                 ? number_of_units * first_cost
                 : unit_limit * first_cost
                   + (number_of_units - unit_limit) * extra_cost;

    total_bill = energy_charge + service_charge;

    // Step 4.5: Print the result
    cout << fixed << setprecision(2);
    cout << "energy charge :" << energy_charge << endl;
    cout << "service charge:" << service_charge << endl;
    cout << "total bill:" << total_bill << endl;

    return 0;
}
















