C++ code


#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    // Step 1: Declaration of  variables
    double distance;
    int hours, minutes;
    double fuelUse, pricePerLiter;

    double totalHours;
    double averageSpeed;
    double fuelUsed;
    double fuelCost;

    // Step 2: read the Inputs
    cout << "Enter distance (km): ";
    cin >> distance;

    cout << "Enter travel time (hours): ";
    cin >> hours;

    cout << "Enter travel time (minutes): ";
    cin >> minutes;

    cout << "Enter fuel use (liters per 100 km): ";
    cin >> fuelUse;

    cout << "Enter price per liter (birr): ";
    cin >> pricePerLiter;

    // Step 3: calculations
    totalHours = hours + minutes / 60.0;

    averageSpeed = distance / totalHours;

    fuelUsed = (distance * fuelUse) / 100.0;

    fuelCost = fuelUsed * pricePerLiter;

    // Step 4: output
    cout << fixed << setprecision(2);
    cout << "Average speed: " << averageSpeed << " km/h" << endl;
    cout << "Fuel used: " << fuelUsed << " liters" << endl;
    cout << "Fuel cost: " << fuelCost << " birr" << endl;

    return 0;
}










